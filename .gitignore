# Виртуальное окружение
venv/
.env

# Python-кэш
__pycache__/
*.pyc

# IDE
.vscode/
.idea/

# Секреты
*.key
*.env

# Источники истории (у каждого профиля свой файл)
history.json
history_*.json
*.tmp

# База знаний: свои заметки по умолчанию не коммитятся,
# но демо-набор для eval разрешён явно
data/*
!data/.gitkeep
!data/LLM основы и архитектура трансформеров.md
!data/MCP-протокол.md
!data/Безопасность AI.md
!data/Виды моделей и провайдеры.md
!data/Генерация и экономия API.md
!data/Кастомизация знаний моделей.md
!data/Контекстная vs промт-инженерия.md
!data/Контекстное окно и память.md
!data/Тренды — MOE, AGI, ASI.md
!data/Тренинг, инференс и память.md
!data/Управление креативностью.md

# Отчёты и черновики eval генерируются заново
eval/results/*
!eval/results/.gitkeep
eval/drafts_*.json
